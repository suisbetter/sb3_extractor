{
  "name": "sb3-converter",
  "productName": "SB3 Converter & Extractor",
  "version": "1.0.0",
  "description": "Extract Scratch 3 (.sb3) projects into organised folders and generate a standalone HTML player.",
  "main": "electron/main.js",
  "author": "suisbetter",
  "license": "MIT",
  "homepage": "https://github.com/suisbetter/sb3_extractor",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder --win --mac --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.suisbetter.sb3converter",
    "productName": "SB3 Converter",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
